# Copy this file to .env and fill in the values before running docker compose up.

# ── Required: ShowBox / FebBox provider ──────────────────────────────────────
# Log in to https://www.febbox.com, open browser DevTools → Application →
# Cookies → www.febbox.com, and copy the value of the "ui" cookie.
# Without this the ShowBox provider returns 0 streams for every title.
FEBBOX_TOKEN=paste_your_febbox_ui_cookie_value_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Strong random string used to sign sessions (recommended for production).
# Generate one with: openssl rand -hex 32
# SESSION_SECRET=
